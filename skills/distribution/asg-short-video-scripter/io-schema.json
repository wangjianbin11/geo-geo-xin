{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asg-content-os/skills/asg-short-video-scripter/io-schema.json",
  "title": "asg-short-video-scripter I/O contract",
  "x-envelope-skill-enum-todo": "asg-short-video-scripter must be added to schemas/envelope.schema.json properties.skill.enum by the integrator",
  "allOf": [{ "$ref": "https://asg-content-os/schemas/envelope.schema.json" }],
  "properties": {
    "skill": { "const": "asg-short-video-scripter" },
    "input": {
      "type": "object",
      "required": ["draft", "publish_package", "article_type", "language"],
      "additionalProperties": false,
      "properties": {
        "draft": { "type": "string", "minLength": 1, "description": "Published article html from dossier.draft.html." },
        "publish_package": {
          "type": "object",
          "required": ["canonical_url"],
          "additionalProperties": true,
          "properties": {
            "canonical_url": { "type": "string", "minLength": 1 },
            "meta_variants": { "type": "array", "items": { "type": "object" } }
          }
        },
        "article_type": { "type": "string", "enum": ["pillar", "share", "response"] },
        "language": { "type": "string", "enum": ["en-GB", "en-US"] },
        "source_library_refs": {
          "type": "array",
          "description": "Library IDs already present in the source article; scripter may only reuse from this set, never add new.",
          "items": { "type": "string", "pattern": "^(FACT|CASE|SOURCE|VOICE|TOPIC)-[A-Za-z0-9-]+$" }
        }
      }
    },
    "output": {
      "type": "object",
      "required": ["script", "shot_list", "library_refs", "decision"],
      "additionalProperties": false,
      "properties": {
        "script": {
          "type": "object",
          "required": ["hook", "body", "cta", "word_count"],
          "additionalProperties": false,
          "properties": {
            "hook": { "type": "string", "minLength": 1, "description": "First 3 seconds; reused Janson first-person anchor." },
            "body": { "type": "string", "minLength": 1, "description": "One core takeaway voiceover; density per publishing-gate §A 适配分发 row." },
            "cta": { "type": "string", "minLength": 1, "description": "Soft full-article CTA, no earnings promise." },
            "word_count": { "type": "integer", "minimum": 150, "maximum": 250, "description": "Total script words; ~150-250 for short video." }
          }
        },
        "shot_list": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["scene", "visual", "seconds"],
            "additionalProperties": false,
            "properties": {
              "scene": { "type": "string", "enum": ["hook", "body", "cta"] },
              "visual": { "type": "string", "minLength": 1 },
              "caption": { "type": "string" },
              "seconds": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        },
        "total_seconds": { "type": "number", "exclusiveMinimum": 0, "description": "Sum of shot_list seconds; should be self-consistent with word_count (~2.5 words/sec)." },
        "library_refs": {
          "type": "array",
          "description": "Subset of input.source_library_refs actually carried into the script. Never a superset.",
          "items": { "type": "string", "pattern": "^(FACT|CASE|SOURCE|VOICE|TOPIC)-[A-Za-z0-9-]+$" }
        },
        "decision": { "type": "string", "enum": ["ok", "flagged", "error"] },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
